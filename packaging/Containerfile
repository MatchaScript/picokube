# The node image the e2e suite runs on: a Fedora bootc host carrying
# everything picokube expects to already be present (kubelet, CRI-O, kubectl,
# CNI plugins) plus the picokube binary, its units and the compiled e2e suite.
# It is a test fixture, not a release artefact — releases are the picokube
# binary and its units, per Kubernetes minor.
#
# Layout follows homelab's containers/bootc/kubernetes/base.Containerfile: the
# kubelet/CRI-O RPMs come from pkgs.k8s.io and the openSUSE cri-o repo, pinned
# to one minor through /etc/dnf/vars.
#
#   podman build -t picokube-node:dev -f packaging/Containerfile .

FROM docker.io/library/golang:1.26 AS gobuild
WORKDIR /src
COPY . .
# The e2e suite is baked in and always built: it is how the image gets
# verified, and a second image variant would be the thing that then goes
# untested. CGO_ENABLED=0 so both binaries run on the Fedora rootfs.
#
# Cache mounts keep the module and build caches out of the committed layer;
# k8s.io/kubernetes alone is several hundred thousand small files, and
# unpacking that layer is what exhausts btrfs metadata on the build host.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /out/picokube ./cmd/picokube && \
    CGO_ENABLED=0 go test -c -tags e2e -o /out/e2e.test ./test/e2e

FROM quay.io/fedora/fedora-bootc:44@sha256:71e4c657272bba6c9c21c5825b26faec58fdfacf4b62e7643c98d3f50a3a3541

# Must match the k8s.io/kubernetes minor in go.mod: the suite exercises the
# embedded kubeadm against the kubelet installed here.
ARG KUBE_MINOR=v1.36

COPY packaging/overlay.d/10-kubernetes/ /

# Both repo files interpolate these ($kubever, $criover), so one arg pins the
# kubelet, kubectl and CRI-O minor together.
RUN echo "$KUBE_MINOR" > /etc/dnf/vars/kubever && \
    echo "$KUBE_MINOR" > /etc/dnf/vars/criover

# crun, container-selinux, systemd-resolved and openssh-server are already in
# fedora-bootc:44. containernetworking-plugins is the loopback plugin CRI-O
# needs for every sandbox; cri-tools is crictl, which the suite shells out to.
RUN dnf install -y --setopt=install_weak_deps=False \
    --setopt=tsflags=nodocs \
    cri-o \
    kubelet \
    kubectl \
    cri-tools \
    containernetworking-plugins \
    systemd-networkd \
    greenboot

# NetworkManager ships enabled in the base. Removing it takes dracut-network,
# kdump-utils and clevis-dracut with it, so mask instead: networkd owns the
# NIC, and only networkd leaves the hostname alone (no reverse-lookup rename
# mid-run, which would break every system:node:<name> authorization).
RUN systemctl mask NetworkManager NetworkManager-wait-online \
    NetworkManager-cloud-setup && \
    systemctl enable systemd-networkd systemd-resolved sshd greenboot-healthcheck

# The cri-o rpm ships its default bridge disabled. It is what keeps the node
# Ready before a CNI is installed — `picokube init` waits for Ready. Enable it,
# but rename the bridge: the shipped name is the one every CNI expects to own,
# and flannel then refuses it ("cni0 already has an IP address different from
# 10.244.0.1/24") and no pod gets a sandbox. Pods created before the real CNI
# keep working on crio0.
RUN mv /etc/cni/net.d/*-crio-bridge.conflist.disabled \
       /etc/cni/net.d/100-crio-bridge.conflist && \
    sed -i 's|"bridge": "[^"]*"|"bridge": "crio0"|' \
       /etc/cni/net.d/100-crio-bridge.conflist

# CNI DaemonSets install their plugin by writing to the hostPath /opt/cni/bin
# (flannel's install-cni-plugin init container, for one). /opt is a real
# directory on the read-only root here, not the usual symlink into /var, so
# that write fails with EROFS. Point it at the writable directory CRI-O now
# scans first.
RUN ln -s /var/lib/cni /opt/cni

# kubeadm's kube-controller-manager manifest mounts the flexvolume directory
# unconditionally with hostPath DirectoryOrCreate. /usr is read-only on a bootc
# host, so kubelet's mkdir fails and the pod never leaves ContainerCreating;
# the directory has to exist in the image. Flatcar carries the same fix at OS
# level (scripts/changelog/changes/2023-10-09-kubernetes-usr-libexec.md), as a
# symlink to a writable path — a plain directory is enough here because nothing
# installs flexvolume plugins on this node.
RUN mkdir -p /usr/libexec/kubernetes/kubelet-plugins/volume/exec

COPY --from=gobuild /out/picokube /usr/bin/picokube
COPY --from=gobuild /out/e2e.test /usr/libexec/picokube/e2e.test
COPY packaging/systemd/picokube.service /usr/lib/systemd/system/
COPY packaging/systemd/10-picokube.conf /usr/lib/systemd/system/multi-user.target.d/
COPY packaging/systemd/greenboot-healthcheck.service.d/ /usr/lib/systemd/system/greenboot-healthcheck.service.d/
COPY packaging/systemd/greenboot-set-rollback-trigger.service.d/ /usr/lib/systemd/system/greenboot-set-rollback-trigger.service.d/
COPY packaging/crictl.yaml /etc/crictl.yaml
COPY packaging/greenboot/ /etc/greenboot/

# bootc lint warns on both of these: var-log for /var/log/dnf5.log and
# var-tmpfiles for the /var/lib and /var/cache directories dnf left without
# tmpfiles.d entries. /run/dnf trips nonempty-run-tmp.
RUN dnf clean all && rm -rf /var/{log,cache,lib}/* /run/dnf
RUN bootc container lint

LABEL containers.bootc 1
LABEL ostree.bootable 1
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
